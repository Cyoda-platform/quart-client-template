{
  "name": "Customer",
  "modelVersion": 1,
  "type": "entity",
  "properties": {
    "customerId": { "type": "string", "description": "Unique customer identifier (UUID)" },
    "customerType": { "type": "string", "description": "'individual' or 'corporate'" },
    "firstName": { "type": "string" },
    "lastName": { "type": "string" },
    "dateOfBirth": { "type": "string", "format": "date" },
    "nationality": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "phoneNumber": { "type": "string" },
    "addresses": { "type": "array", "items": { "type": "object", "properties": { "line1": { "type": "string" }, "line2": { "type": "string" }, "city": { "type": "string" }, "region": { "type": "string" }, "postalCode": { "type": "string" }, "country": { "type": "string" } } } },
    "identificationDocuments": { "type": "array", "items": { "type": "object", "properties": { "docType": { "type": "string" }, "docNumber": { "type": "string" }, "issuedCountry": { "type": "string" }, "expiryDate": { "type": "string", "format": "date" }, "providerResponse": { "type": "object" } } } },
    "corporateDetails": { "type": "object", "properties": { "companyName": { "type": "string" }, "registrationNumber": { "type": "string" }, "beneficialOwners": { "type": "array", "items": { "type": "string" } } } },
    "kycStatus": { "type": "string", "description": "pending, verified, rejected, manual_review" },
    "riskScore": { "type": "number" },
    "watchlistHits": { "type": "array", "items": { "type": "object" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["customerId", "customerType", "createdAt"]
}