      "workspace_id": {"type": "string", "format": "uuid", "example": "b3d5f6a2-1f4b-4c2b-9f2e-1234567890ab"},
      "name": {"type": "string", "example": "Payments Project"},
      "description": {"type": "string", "example": "Handles payment-related test cases.", "nullable": true},
