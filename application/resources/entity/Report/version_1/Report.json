{
  "name": "Report",
  "version": 1,
  "id": "report_id",
  "fields": {
    "report_id": { "type": "string", "description": "Unique report identifier" },
    "generated_at": { "type": "string", "format": "date-time", "description": "Timestamp when report was generated" },
    "csv_source_url": { "type": "string", "description": "Source CSV URL" },
    "summary_stats": { "type": "object", "description": "Summary statistics generated by pandas" },
    "report_path": { "type": "string", "description": "Path to generated report file in storage" },
    "recipients": { "type": "array", "items": { "type": "string" }, "description": "List of recipient emails" },
    "status": { "type": "string", "description": "Status: pending, sent, failed" }
  }
}