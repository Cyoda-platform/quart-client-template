{
  "name": "customer",
  "display_name": "Customer",
  "version": 1,
  "description": "Represents a customer with contact information.",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the customer",
      "required": true
    },
    {
      "name": "name",
      "type": "string",
      "description": "Full name of the customer",
      "required": true
    },
    {
      "name": "email",
      "type": "string",
      "format": "email",
      "description": "Email address of the customer",
      "required": true
    },
    {
      "name": "phone",
      "type": "string",
      "description": "Phone number of the customer",
      "required": false
    }
  ],
  "primary_key": ["id"]
}