{
  "name": "customer",
  "version": 1,
  "description": "Represents a customer in the system",
  "fields": [
    {
      "name": "id",
      "type": "uuid",
      "description": "Unique identifier for the customer",
      "required": true
    },
    {
      "name": "name",
      "type": "string",
      "description": "Customer's full name",
      "required": true
    },
    {
      "name": "email",
      "type": "string",
      "format": "email",
      "description": "Customer's email address",
      "required": true
    },
    {
      "name": "phone",
      "type": "string",
      "description": "Customer's phone number",
      "required": false
    }
  ]
}