{
  "name": "customer",
  "version": 1,
  "description": "Customer entity representing a user/customer in the system.",
  "fields": [
    {
      "name": "id",
      "type": "uuid",
      "description": "Unique identifier for the customer",
      "primary_key": true
    },
    {
      "name": "name",
      "type": "string",
      "description": "Full name of the customer"
    },
    {
      "name": "email",
      "type": "string",
      "description": "Email address of the customer",
      "format": "email"
    },
    {
      "name": "phone",
      "type": "string",
      "description": "Phone number of the customer",
      "format": "phone"
    }
  ]
}