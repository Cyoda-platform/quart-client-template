{
  "name": "instrument",
  "version": 1,
  "description": "Instrument entity describing traded instruments (equities, options, futures)",
  "properties": {
    "id": { "type": "string", "description": "Instrument identifier (symbol/ISIN)" },
    "type": { "type": "string", "description": "Equity, Option, Future, etc." },
