{
  "name": "TimeEntry",
  "version": 1,
  "fields": [
    {
      "name": "entry_id",
      "type": "string",
      "required": true,
      "description": "Business identifier for the time entry"
    },
    {
      "name": "task_id",
      "type": "string",
      "required": true,
      "description": "Technical ID of the parent task"
    },
    {
      "name": "user_id",
      "type": "string",
      "required": true,
      "description": "Technical ID of the user logging time"
    },
    {
      "name": "start_time",
      "type": "string",
      "required": true,
      "description": "Start timestamp (ISO 8601 format)"
    },
    {
      "name": "end_time",
      "type": "string",
      "required": false,
      "description": "End timestamp (ISO 8601 format)"
    },
    {
      "name": "duration_minutes",
      "type": "number",
      "required": true,
      "description": "Duration in minutes"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "Description of work performed"
    }
  ]
}
