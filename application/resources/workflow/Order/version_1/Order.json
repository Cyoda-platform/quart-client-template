{
  "version": "1.0",
  "name": "Order Workflow",
  "desc": "Workflow for Order Lifecycle",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "start_validation",
          "next": "validating",
          "manual": false
        }
      ]
    },
    "validating": {
      "transitions": [
        {
          "name": "validate",
          "next": "validated",
          "manual": false,
          "processors": [
            {
              "name": "OrderValidationProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "validated": {
      "transitions": [
        {
          "name": "accept",
          "next": "accepted",
          "manual": false,
          "criterion": {
            "type": "simple",
            "jsonPath": "validation_status",
            "operation": "EQUALS",
            "value": "PASS"
          }
        },
        {
          "name": "reject",
          "next": "rejected",
          "manual": false,
          "criterion": {
            "type": "simple",
            "jsonPath": "validation_status",
            "operation": "EQUALS",
            "value": "FAIL"
          }
        }
      ]
    },
    "accepted": {
      "transitions": [
        {
          "name": "complete",
          "next": "completed",
          "manual": true
        }
      ]
    },
    "rejected": {
      "transitions": [
        {
          "name": "complete",
          "next": "completed",
          "manual": true
        }
      ]
    },
    "completed": {
      "transitions": []
    }
  }
}
