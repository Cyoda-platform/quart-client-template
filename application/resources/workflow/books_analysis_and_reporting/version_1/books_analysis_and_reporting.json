{
  "version": "1",
  "name": "books_analysis_and_reporting",
  "desc": "Analyze fetched books and generate weekly report",
  "initialState": "start",
  "active": true,
  "states": {
    "start": {
      "transitions": [
        {
          "name": "analyze",
          "next": "analyzed",
          "manual": false,
          "processors": [
            {
              "name": "compute_metrics",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": false
              }
            }
          ]
        }
      ]
    },
    "analyzed": {
      "transitions": [
        {
          "name": "generate_report",
          "next": "report_generated",
          "manual": false,
          "processors": [
            {
              "name": "create_report",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": false
              }
            }
          ]
        }
      ]
    },
    "report_generated": {
      "transitions": [
        {
          "name": "email",
          "next": "finished", 
          "manual": false,
          "processors": [
            {
              "name": "send_email",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": false
              }
            }
          ]
        }
      ]
    },
    "finished": {
      "transitions": []
    }
  }
}
