{"version":"1.0","name":"ClaimSubmissionWorkflow","desc":"Workflow to manage claim submission, validation, document ingestion, scoring and routing","initialState":"created","active":true,"states":{"created":{"transitions":[{"name":"validate","next":"validated","manual":false}],"description":"Initial creation of the claim"},"validated":{"transitions":[{"name":"ingest_documents","next":"documents_ingested","manual":false},{"name":"reject","next":"rejected","manual":true}],"description":"Policy, coverage and basic validation"},"documents_ingested":{"transitions":[{"name":"score_claim","next":"scored","manual":false}],"description":"Documents processed and OCR extracted"},"scored":{"transitions":[{"name":"auto_adjudicate","next":"adjudicated","manual":false},{"name":"escalate_for_review","next":"escalation","manual":true}],"description":"Fraud and business rules scoring"},"adjudicated":{"transitions":[{"name":"complete","next":"completed","manual":false}],"description":"Auto-adjudicated and ready for payment"},"escalation":{"transitions":[{"name":"review_complete","next":"adjudicated","manual":true}],"description":"Manual review by adjudicator or fraud analyst"},"rejected":{"transitions":[]},"completed":{"transitions":[{"name":"archive","next":"archived","manual":true}]},"archived":{"transitions":[]}}}