{"version": "1.0", "name": "CustomerLifecycle", "description": "Workflow for Customer lifecycle management", "initialState": "created", "active": true, "states": {"active": {"transitions": [{"manual": true, "name": "suspend", "next": "inactive"}, {"manual": true, "name": "delete", "next": "deleted"}]}, "created": {"transitions": [{"manual": false, "name": "activate", "next": "active"}, {"manual": true, "name": "deactivate", "next": "inactive"}]}, "deleted": {"transitions": []}, "inactive": {"transitions": [{"manual": true, "name": "activate", "next": "active"}, {"manual": true, "name": "delete", "next": "deleted"}]}}}