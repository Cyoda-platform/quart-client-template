{  "version": "2",  "name": "enhanced_order_validation",  "description": "Complex workflow with loops, bidirectional flows and multi-criteria transitions",  "initialState": "new",  "active": true,  "states": {    "new": {      "name": "New Order",      "transitions": [        {          "name": "submit_to_compliance",          "next": "compliance_check",          "manual": false,          "description": "REQ 1: Transition with 1 criterion and 1 processor",          "criterion": {            "type": "simple",            "jsonPath": "$.amount",            "operation": "GREATER_THAN",            "value": 0          },          "processors": [            {              "name": "initial_validation_processor",              "executionMode": "SYNC",              "config": {                "validateSchema": true,                "responseTimeoutMs": 2000,                "calculationNodesTags": "cyoda_application"              }            }          ]        }      ]    },    "compliance_check": {      "name": "Compliance Check (Hub)",      "transitions": [        {          "name": "re_evaluate_risk",          "next": "compliance_check",          "manual": false,          "description": "REQ 4: Loop transition (A -> A). Re-runs calculation if data changed.",          "criterion": {            "type": "simple",            "jsonPath": "$.dataChanged",            "operation": "EQUALS",            "value": true          },          "processors": [            {              "name": "risk_recalculator_processor",              "executionMode": "ASYNC_NEW_TX",              "config": {                "engine": "risk_v2",                "responseTimeoutMs": 5000,                "calculationNodesTags": "cyoda_application"              }            }          ]        },        {          "name": "request_manual_review",          "next": "manual_review",          "manual": false,          "description": "REQ 5 (Part 1): Bidirectional A -> B. Sent to manual if score is ambiguous.",          "criterion": {            "type": "group",            "operator": "AND",            "conditions": [              {                "type": "simple",                "jsonPath": "$.riskScore",                "operation": "GREATER_OR_EQUAL",                "value": 30              },              {                "type": "simple",                "jsonPath": "$.riskScore",                "operation": "LESS_OR_EQUAL",                "value": 70              }            ]          },          "processors": [            {              "name": "assign_officer_processor",              "executionMode": "SYNC",              "config": {                "calculationNodesTags": "cyoda_application"              }            }          ]        },        {          "name": "auto_approve",          "next": "approved",          "manual": false,          "description": "REQ 2: Transition with 2 criteria and 2 processes.",          "criterion": {            "type": "group",            "operator": "AND",            "conditions": [              {                "type": "simple",                "jsonPath": "$.riskScore",                "operation": "LESS_THAN",                "value": 30              },              {                "type": "simple",                "jsonPath": "$.kycStatus",                "operation": "EQUALS",                "value": "VERIFIED"              }            ]          },          "processors": [            {              "name": "execute_trade_processor",              "executionMode": "ASYNC_NEW_TX",              "config": {                "market": "NYSE",                "priority": "high",                "calculationNodesTags": "cyoda_application"              }            },            {              "name": "notify_client_processor",              "executionMode": "ASYNC_SAME_TX",              "config": {                "template": "order_success_email",                "calculationNodesTags": "cyoda_application"              }            }          ]        },        {          "name": "hard_reject",          "next": "rejected",          "manual": false,          "description": "REQ 3: Transition with 3 criteria.",          "criterion": {            "type": "group",            "operator": "AND",            "conditions": [              {                "type": "simple",                "jsonPath": "$.amount",                "operation": "GREATER_THAN",                "value": 1000000              },              {                "type": "simple",                "jsonPath": "$.riskScore",                "operation": "GREATER_THAN",                "value": 90              },              {                "type": "simple",                "jsonPath": "$.traderRegion",                "operation": "EQUALS",                "value": "RESTRICTED"              }            ]          },          "processors": [            {              "name": "audit_log_processor",              "executionMode": "SYNC",              "config": {                "level": "CRITICAL",                "calculationNodesTags": "cyoda_application"              }            }          ]        }      ]    },    "manual_review": {      "name": "Manual Review",      "transitions": [        {          "name": "return_to_compliance",          "next": "compliance_check",          "manual": true,          "description": "REQ 5 (Part 2): Bidirectional B -> A. Officer sends back after adding info.",          "processors": [            {              "name": "update_order_metadata_processor",              "executionMode": "SYNC",              "config": {                "appendNote": true,                "calculationNodesTags": "cyoda_application"              }            }          ]        },        {          "name": "force_reject",          "next": "rejected",          "manual": true        }      ]    },    "approved": {      "name": "Order Approved",      "isFinal": true,      "transitions": []    },    "rejected": {      "name": "Order Rejected",      "isFinal": true,      "transitions": []    }  }}