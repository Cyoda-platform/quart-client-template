{
  "version": "1.0",
  "name": "Fill Workflow",
  "desc": "Workflow for fill execution processing, reconciliation, and position application",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "receive",
          "next": "received",
          "manual": false
        }
      ]
    },
    "received": {
      "transitions": [
        {
          "name": "reconcile",
          "next": "reconciled",
          "manual": false,
          "processors": [
            {
              "name": "ReconcileFillProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "reconciled": {
      "transitions": [
        {
          "name": "apply",
          "next": "applied",
          "manual": false,
          "processors": [
            {
              "name": "ApplyFillToPositionProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "applied": {
      "transitions": []
    }
  }
}
