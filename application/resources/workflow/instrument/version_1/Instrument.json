{
  "version": "1.0",
  "name": "Instrument Workflow",
  "desc": "Instrument lifecycle: active -> inactive",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "activate",
          "next": "active",
          "manual": false
        }
      ]
    },
    "active": {
      "transitions": [
        {
          "name": "deactivate",
          "next": "inactive",
          "manual": true
        }
      ]
    },
    "inactive": {
      "transitions": []
    }
  }
}

