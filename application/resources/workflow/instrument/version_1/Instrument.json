{
  "version": "1.0",
  "name": "Instrument Lifecycle Workflow",
  "desc": "Manages instrument lifecycle and market data updates",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "activate",
          "next": "active",
          "manual": false
        }
      ]
    },
    "active": {
      "transitions": [
        {
          "name": "update_prices",
          "next": "active",
          "manual": false
        },
        {
          "name": "expire",
          "next": "expired",
          "manual": true
        }
      ]
    },
    "expired": {
      "transitions": []
    }
  }
}

