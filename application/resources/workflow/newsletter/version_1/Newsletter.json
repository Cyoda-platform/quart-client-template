{
  "version": "1.0",
  "name": "Newsletter Workflow",
  "desc": "Manages the lifecycle of weekly newsletters from creation to completion",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "fetch_fact",
          "next": "fetched",
          "manual": false,
          "processors": [
            {
              "name": "NewsletterFetchProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "fetched": {
      "transitions": [
        {
          "name": "send",
          "next": "sent",
          "manual": false,
          "processors": [
            {
              "name": "NewsletterSendProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "sent": {
      "transitions": [
        {
          "name": "complete",
          "next": "completed",
          "manual": false
        }
      ]
    },
    "completed": {
      "transitions": []
    }
  }
}
