{"name": "Order Lifecycle", "desc": "Order lifecycle workflow handling validation, routing, execution, fills, cancellations, and post-trade updates.", "initialState": "created", "active": true, "states": {"created": {"transitions": [{"name": "validate", "next": "validated", "manual": false}, {"name": "cancel", "next": "cancelled", "manual": true}]}, "validated": {"transitions": [{"name": "route", "next": "routed", "manual": false}, {"name": "reject", "next": "rejected", "manual": true}, {"name": "cancel", "next": "cancelled", "manual": true}]}, "routed": {"transitions": [{"name": "acknowledge", "next": "working", "manual": false}, {"name": "reject", "next": "rejected", "manual": false}, {"name": "cancel_request", "next": "cancelled", "manual": true}]}, "working": {"transitions": [{"name": "partial_fill", "next": "partially_filled", "manual": false}, {"name": "fill", "next": "filled", "manual": false}, {"name": "cancel_request", "next": "cancelled", "manual": true}, {"name": "fail", "next": "failed", "manual": false}]}, "partially_filled": {"transitions": [{"name": "fill", "next": "filled", "manual": false}, {"name": "cancel_request", "next": "cancelled", "manual": true}]}, "filled": {"transitions": [{"name": "settle", "next": "settled", "manual": false}, {"name": "archive", "next": "archived", "manual": true}]}, "settled": {"transitions": [{"name": "archive", "next": "archived", "manual": true}]}, "rejected": {"transitions": []}, "cancelled": {"transitions": []}, "failed": {"transitions": [{"name": "retry", "next": "working", "manual": true}, {"name": "cancel", "next": "cancelled", "manual": true}]}, "archived": {"transitions": []}}}