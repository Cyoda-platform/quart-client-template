{
  "version": "1.0",
  "name": "Order",
  "description": "Workflow",
  "initialState": "initial_state",
  "active": false,
  "states": {
    "cancelled": {
      "transitions": []
    },
    "created": {
      "transitions": [
        {
          "description": "Update order details (user-initiated)",
          "manual": false,
          "name": "update",
          "next": "updated"
        },
        {
          "name": "New Transition",
          "next": "updated",
          "manual": false,
          "disabled": false
        }
      ]
    },
    "initial_state": {
      "transitions": [
        {
          "description": "Create a new order (user-initiated)",
          "manual": true,
          "name": "create",
          "next": "created"
        }
      ]
    },
    "updated": {
      "transitions": [
        {
          "description": "Cancel the order after updates",
          "manual": true,
          "name": "cancel",
          "next": "cancelled"
        }
      ]
    }
  }
}