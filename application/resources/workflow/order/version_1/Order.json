{
  "active": true,
  "desc": "Workflow for Order entity with create, update, and cancel transitions",
  "initialState": "initial_state",
  "name": "Order",
  "states": {
    "cancelled": {
      "transitions": []
    },
    "created": {
      "transitions": [
        {
          "description": "Update order details (user-initiated)",
          "manual": false,
          "name": "update",
          "next": "updated"
        }
      ]
    },
    "initial_state": {
      "transitions": [
        {
          "description": "Create a new order (user-initiated)",
          "manual": true,
          "name": "create",
          "next": "created"
        }
      ]
    },
    "updated": {
      "transitions": [
        {
          "description": "Cancel the order after updates",
          "manual": true,
          "name": "cancel",
          "next": "cancelled"
        }
      ]
    }
  },
  "version": "1.0"
}
