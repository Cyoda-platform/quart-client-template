{
  "version": "1.0",
  "name": "Order Workflow",
  "desc": "Workflow for Order entity with shipment lifecycle",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "WAITING_TO_FULFILL",
          "manual": false
        }
      ]
    },
    "WAITING_TO_FULFILL": {
      "transitions": [
        {
          "name": "CREATE_ORDER_FROM_PAID",
          "next": "PICKING",
          "manual": true,
          "processors": [
            {
              "name": "CreateOrderFromPaidProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "PICKING": {
      "transitions": [
        {
          "name": "READY_TO_SEND",
          "next": "WAITING_TO_SEND",
          "manual": true
        }
      ]
    },
    "WAITING_TO_SEND": {
      "transitions": [
        {
          "name": "MARK_SENT",
          "next": "SENT",
          "manual": true
        }
      ]
    },
    "SENT": {
      "transitions": [
        {
          "name": "MARK_DELIVERED",
          "next": "DELIVERED",
          "manual": true
        }
      ]
    },
    "DELIVERED": {
      "transitions": []
    }
  }
}

