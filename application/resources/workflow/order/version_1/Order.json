{
  "version": "1.0",
  "name": "Order",
  "desc": "Workflow for Order entity with create, update, and cancel transitions",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "created",
          "manual": true,
          "description": "Create a new order (user-initiated)"
        }
      ]
    },
    "created": {
      "transitions": [
        {
          "name": "update",
          "next": "updated",
          "manual": true,
          "description": "Update order details (user-initiated)"
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true,
          "description": "Cancel the order (user-initiated)"
        }
      ]
    },
    "updated": {
      "transitions": [
        {
          "name": "update",
          "next": "updated",
          "manual": true,
          "description": "Apply another update to the order"
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true,
          "description": "Cancel the order after updates"
        }
      ]
    },
    "cancelled": {
      "transitions": []
    }
  }
}