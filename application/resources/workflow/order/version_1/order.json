{
  "version": "1",
  "name": "order",
  "desc": "Order lifecycle workflow with create, update, and cancel transitions",
  "initialState": "initial",
  "active": true,
  "states": {
    "initial": {
      "transitions": [
        {"name": "create", "next": "created", "manual": false}
      ]
    },
    "created": {
      "transitions": [
        {"name": "update", "next": "updated", "manual": true},
        {"name": "cancel", "next": "cancelled", "manual": true}
      ]
    },
    "updated": {
      "transitions": [
        {"name": "update", "next": "updated", "manual": true},
        {"name": "cancel", "next": "cancelled", "manual": true}
      ]
    },
    "cancelled": {
      "transitions": []
    }
  }
}