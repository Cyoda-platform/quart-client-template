      ]
    },
    {
      "name": "deliver_order",
      "from": "SHIPPED",
      "to": "DELIVERED",
      "trigger": "order_delivered",
      "actions": [
        {"type": "set_field", "field": "status", "value": "DELIVERED"},
        {"type": "set_field", "field": "delivered_at", "value": "now"}
      ]
    },
    {
      "name": "cancel_order",
      "from": ["PLACED", "PROCESSING", "PACKED"],
