{
  "name": "order_fulfillment",
  "entity": "order",
  "description": "Standard order fulfillment workflow for Order entity",
  "initial_state": "PLACED",
  "states": [
    "PLACED",
    "PROCESSING",
    "PACKED",
    "SHIPPED",
    "DELIVERED",
    "CANCELLED",
    "RETURNED"
  ],
  "transitions": [
    {
      "name": "confirm_payment",
      "from": "PLACED",
      "to": "PROCESSING",
      "trigger": "payment_confirmed",
      "actions": [
        {"type": "set_field", "field": "status", "value": "PROCESSING"},
        {"type": "log", "message": "Payment confirmed, moving to PROCESSING"}
      ]
    },
    {
      "name": "pack_order",
      "from": "PROCESSING",
      "to": "PACKED",
