      "actions": [
        {"type": "set_field", "field": "status", "value": "CANCELLED"},
        {"type": "notify", "to": "customer", "message": "Your order has been cancelled"}
      ]
    },
    {
      "name": "return_order",
      "from": "DELIVERED",
      "to": "RETURNED",
