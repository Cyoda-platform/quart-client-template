{
  "version": "1.0",
  "name": "order_processing",
  "desc": "Workflow for managing order processing lifecycle from creation to completion",
  "initialState": "created",
  "active": true,
  "states": {
    "created": {
      "transitions": [
        {
          "name": "validate",
          "next": "validated",
          "manual": false,
          "processors": [
            {
              "name": "OrderValidator",
              "executionMode": "SYNC",
              "config": {}
            },
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true,
          "processors": [
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        }
      ]
    },
    "validated": {
      "transitions": [
        {
          "name": "process",
          "next": "processing",
          "manual": false,
          "processors": [
            {
              "name": "RiskEvaluator",
              "executionMode": "SYNC",
              "config": {}
            },
            {
              "name": "SmartRouter",
              "executionMode": "ASYNC_NEW_TX",
              "config": {}
            },
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        },
        {
          "name": "reject",
          "next": "rejected",
          "manual": true,
          "processors": [
            {
              "name": "AlertingProcessor",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            },
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true,
          "processors": [
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        }
      ]
    },
    "processing": {
      "transitions": [
        {
          "name": "complete",
          "next": "completed",
          "manual": false,
          "processors": [
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        },
        {
          "name": "fail",
          "next": "failed",
          "manual": false,
          "processors": [
            {
              "name": "AlertingProcessor",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            },
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        }
      ]
    },
    "completed": {
      "transitions": [
        {
          "name": "archive",
          "next": "archived",
          "manual": true
        }
      ]
    },
    "rejected": {
      "transitions": [
        {
          "name": "resubmit",
          "next": "created",
          "manual": true
        }
      ]
    },
    "failed": {
      "transitions": [
        {
          "name": "retry",
          "next": "processing",
          "manual": true
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true
        }
      ]
    },
    "cancelled": {
      "transitions": []
    },
    "archived": {
      "transitions": []
    }
  }
}