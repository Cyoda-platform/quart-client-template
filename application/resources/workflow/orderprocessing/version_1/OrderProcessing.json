{
  "version": "1.0",
  "name": "OrderProcessing",
  "desc": "Workflow for Order entity handling create, update, and cancel",
  "initialState": "created",
  "active": true,
  "states": {
    "created": {
      "transitions": [
        {
          "name": "update",
          "next": "updated",
          "manual": false,
          "processors": [
            {
              "name": "OrderUpdateProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true
              }
            }
          ]
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true
        }
      ]
    },
    "updated": {
      "transitions": [
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true
        }
      ]
    },
    "cancelled": {
      "transitions": []
    }
  }
}