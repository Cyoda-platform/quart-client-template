{
  "version": "1",
  "name": "OrderWorkflow",
  "desc": "Workflow to manage Order entity lifecycle with create, update, and cancel transitions",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "initial_state",
          "manual": false,
          "processors": [
            {
              "name": "validate_order",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 5000
              }
            },
            {
              "name": "persist_order",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 10000
              }
            }
          ]
        },
        {
          "name": "update",
          "next": "updated",
          "manual": false,
          "processors": [
            {
              "name": "validate_update",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 5000
              }
            },
            {
              "name": "persist_update",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 8000
              }
            }
          ]
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true,
          "processors": [
            {
              "name": "mark_cancelled",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 5000
              }
            }
          ]
        }
      ]
    },
    "updated": {
      "transitions": [
        {
          "name": "update",
          "next": "updated",
          "manual": false,
          "processors": [
            {
              "name": "validate_update",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 5000
              }
            },
            {
              "name": "persist_update",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 8000
              }
            }
          ]
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": true,
          "processors": [
            {
              "name": "mark_cancelled",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application",
                "attachEntity": true,
                "responseTimeoutMs": 5000
              }
            }
          ]
        }
      ]
    },
    "cancelled": {
      "transitions": []
    }
  }
}