{
  "version": 1,
  "name": "OrderWorkflow",
  "initialState": "Created",
  "states": [
    {
      "name": "Created",
      "transitions": [
        {"name": "confirm", "to": "Confirmed", "guard": null, "actions": ["assignOrderNumber"]},
        {"name": "cancel", "to": "Cancelled", "guard": null, "actions": ["refundPayment"]}
      ]
    },
    {
      "name": "Confirmed",
      "transitions": [
        {"name": "pack", "to": "Packed", "guard": null, "actions": ["reserveInventory"]},
        {"name": "cancel", "to": "Cancelled", "guard": null, "actions": ["refundPayment"]}
      ]
    },
    {
      "name": "Packed",
      "transitions": [
        {"name": "ship", "to": "Shipped", "guard": null, "actions": ["createShipment"]},
        {"name": "cancel", "to": "Cancelled", "guard": null, "actions": ["restockInventory","refundPayment"]}
      ]
    },
    {
      "name": "Shipped",
      "transitions": [
        {"name": "deliver", "to": "Delivered", "guard": null, "actions": ["confirmDelivery"]},
        {"name": "return", "to": "Returned", "guard": null, "actions": ["initiateReturn"]}
      ]
    },
    {
      "name": "Delivered",
      "transitions": [
        {"name": "return", "to": "Returned", "guard": null, "actions": ["initiateReturn"]}
      ]
    },
    {
      "name": "Cancelled",
      "transitions": []
    },
    {
      "name": "Returned",
      "transitions": [
        {"name": "restock", "to": "Returned", "guard": null, "actions": ["restockInventory"]}
      ]
    }
  ]
}