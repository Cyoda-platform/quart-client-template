{
  "version": "1.0",
  "name": "OrderWorkflow",
  "desc": "Workflow for Order entity supporting create, update, and cancel transitions",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "created",
          "manual": false,
          "processors": [
            {
              "name": "persist_entity",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "created": {
      "transitions": [
        {
          "name": "update",
          "next": "updated",
          "manual": false,
          "processors": [
            {
              "name": "apply_updates",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": false,
          "processors": [
            {
              "name": "mark_cancelled",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "updated": {
      "transitions": [
        {
          "name": "cancel",
          "next": "cancelled",
          "manual": false,
          "processors": [
            {
              "name": "mark_cancelled",
              "executionMode": "SYNC",
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "cancelled": {
      "transitions": []
    }
  }
}