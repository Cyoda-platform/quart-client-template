{
  "version": "1.0",
  "name": "Payment Processing Workflow",
  "desc": "Workflow for payment processing with fraud detection, authorization, and capture",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "created",
          "manual": false
        }
      ]
    },
    "created": {
      "transitions": [
        {
          "name": "score_fraud",
          "next": "fraud_scored",
          "manual": false,
          "criterion": {
            "type": "function",
            "function": {
              "name": "FraudDetectionCriterion",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          }
        }
      ]
    },
    "fraud_scored": {
      "transitions": [
        {
          "name": "authorize",
          "next": "authorized",
          "manual": false,
          "processors": [
            {
              "name": "PaymentProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "decline",
          "next": "declined",
          "manual": true
        }
      ]
    },
    "authorized": {
      "transitions": [
        {
          "name": "capture",
          "next": "captured",
          "manual": false
        },
        {
          "name": "void",
          "next": "voided",
          "manual": true
        }
      ]
    },
    "captured": {
      "transitions": [
        {
          "name": "refund",
          "next": "refunded",
          "manual": true
        }
      ]
    },
    "declined": {
      "transitions": []
    },
    "voided": {
      "transitions": []
    },
    "refunded": {
      "transitions": []
    }
  }
}

