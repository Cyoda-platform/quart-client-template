{
  "version": "1.0",
  "name": "Position Workflow",
  "desc": "Position lifecycle: open -> pnl_calculated -> closed",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "open",
          "next": "open",
          "manual": false
        }
      ]
    },
    "open": {
      "transitions": [
        {
          "name": "calculate_pnl",
          "next": "pnl_calculated",
          "manual": false,
          "processors": [
            {
              "name": "PnlCalculationProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "close",
          "next": "closed",
          "manual": true
        }
      ]
    },
    "pnl_calculated": {
      "transitions": [
        {
          "name": "update_pnl",
          "next": "pnl_calculated",
          "manual": false,
          "processors": [
            {
              "name": "PnlCalculationProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "close",
          "next": "closed",
          "manual": true
        }
      ]
    },
    "closed": {
      "transitions": []
    }
  }
}

