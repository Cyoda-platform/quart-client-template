{
  "version": "1.0",
  "name": "position_valuation",
  "desc": "Workflow to recalculate positions and P&L on market data updates or executions",
  "initialState": "pending",
  "active": true,
  "states": {
    "pending": {
      "transitions": [
        {
          "name": "calculate",
          "next": "calculated",
          "manual": false,
          "processors": [
            {
              "name": "MarketDataIngestor",
              "executionMode": "SYNC",
              "config": {}
            },
            {
              "name": "PositionUpdater",
              "executionMode": "SYNC",
              "config": {}
            },
            {
              "name": "PnlCalculator",
              "executionMode": "SYNC",
              "config": {}
            }
          ]
        }
      ]
    },
    "calculated": {
      "transitions": [
        {
          "name": "publish",
          "next": "published",
          "manual": false,
          "processors": [
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        }
      ]
    },
    "published": {
      "transitions": [
        {
          "name": "archive",
          "next": "archived",
          "manual": true,
          "processors": [
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        }
      ]
    },
    "archived": { "transitions": [] }
  }
}