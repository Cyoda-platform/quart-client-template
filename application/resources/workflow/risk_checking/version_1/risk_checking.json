{
  "version": "1.0",
  "name": "risk_checking",
  "desc": "Workflow for pre-trade and intra-day risk checks",
  "initialState": "pending",
  "active": true,
  "states": {
    "pending": {
      "transitions": [
        {
          "name": "evaluate",
          "next": "evaluated",
          "manual": false,
          "processors": [
            {
              "name": "RiskEvaluator",
              "executionMode": "SYNC",
              "config": {}
            },
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        }
      ]
    },
    "evaluated": {
      "transitions": [
        {
          "name": "approve",
          "next": "approved",
          "manual": false,
          "processors": [
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        },
        {
          "name": "reject",
          "next": "rejected",
          "manual": true,
          "processors": [
            {
              "name": "AlertingProcessor",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            },
            {
              "name": "ComplianceLogger",
              "executionMode": "ASYNC_SAME_TX",
              "config": {}
            }
          ]
        }
      ]
    },
    "approved": { "transitions": [ { "name": "proceed", "next": "completed", "manual": false } ] },
    "rejected": { "transitions": [ { "name": "notify", "next": "notified", "manual": true } ] },
    "notified": { "transitions": [] },
    "completed": { "transitions": [] }
  }
}