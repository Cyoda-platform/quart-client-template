{
  "version": "1.0",
  "name": "RiskControl Workflow",
  "desc": "Workflow for risk limit monitoring and breach management",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "created",
          "manual": false
        }
      ]
    },
    "created": {
      "transitions": [
        {
          "name": "activate",
          "next": "active",
          "manual": false,
          "processors": [
            {
              "name": "RiskControlActivationProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    },
    "active": {
      "transitions": [
        {
          "name": "update_exposure",
          "next": "active",
          "manual": true,
          "processors": [
            {
              "name": "RiskControlExposureProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "breach",
          "next": "breached",
          "manual": false,
          "processors": [
            {
              "name": "RiskControlBreachProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "deactivate",
          "next": "inactive",
          "manual": true
        }
      ]
    },
    "breached": {
      "transitions": [
        {
          "name": "resolve",
          "next": "active",
          "manual": true,
          "processors": [
            {
              "name": "RiskControlResolveProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "deactivate",
          "next": "inactive",
          "manual": true
        }
      ]
    },
    "inactive": {
      "transitions": [
        {
          "name": "activate",
          "next": "active",
          "manual": true,
          "processors": [
            {
              "name": "RiskControlActivationProcessor",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        }
      ]
    }
  }
}
