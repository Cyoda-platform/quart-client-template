{
  "version": "1.0",
  "name": "RiskLimit Workflow",
  "desc": "Workflow for risk limit management",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "active",
          "manual": false
        }
      ]
    },
    "active": {
      "transitions": [
        {
          "name": "suspend",
          "next": "suspended",
          "manual": true
        },
        {
          "name": "deactivate",
          "next": "inactive",
          "manual": true
        }
      ]
    },
    "suspended": {
      "transitions": [
        {
          "name": "reactivate",
          "next": "active",
          "manual": true
        }
      ]
    },
    "inactive": {
      "transitions": []
    }
  }
}
