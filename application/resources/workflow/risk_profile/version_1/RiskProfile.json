{
  "version": "1.0",
  "name": "Risk Check Workflow",
  "desc": "Manages risk checks and limit monitoring",
  "initialState": "initial_state",
  "active": true,
  "states": {
    "initial_state": {
      "transitions": [
        {
          "name": "create",
          "next": "active",
          "manual": false
        }
      ]
    },
    "active": {
      "transitions": [
        {
          "name": "check_limits",
          "next": "active",
          "manual": false,
          "criterion": {
            "type": "function",
            "function": {
              "name": "RiskCheckCriterion",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          },
          "processors": [
            {
              "name": "RiskChecker",
              "executionMode": "SYNC",
              "config": {
                "calculationNodesTags": "cyoda_application"
              }
            }
          ]
        },
        {
          "name": "breach",
          "next": "breached",
          "manual": true
        }
      ]
    },
    "breached": {
      "transitions": [
        {
          "name": "resolve",
          "next": "resolved",
          "manual": true
        }
      ]
    },
    "resolved": {
      "transitions": [
        {
          "name": "reactivate",
          "next": "active",
          "manual": true
        }
      ]
    }
  }
}

