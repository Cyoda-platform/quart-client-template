{
  "version": "1",
  "name": "TestRunExecution",
  "description": "Manages TestRun lifecycle and step-level execution updates",
  "initialState": "planned",
  "active": true,
  "states": {
    "active": {
      "onEvents": {
        "update_step_result": {
          "description": "Handle step-level result updates and attachments",
          "manual": false,
          "processors": [
            {
              "config": {
                "attachEntity": false,
                "calculationNodesTags": "cyoda_application"
              },
              "executionMode": "SYNC",
              "name": "AtomicFailureEvaluator"
            },
            {
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application"
              },
              "executionMode": "ASYNC_SAME_TX",
              "name": "AttachmentUploader"
            }
          ]
        }
      },
      "transitions": [
        {
          "allowedRoles": [
            "Admin",
            "Tester"
          ],
          "description": "Complete the run, set completed_at and lock the run",
          "manual": true,
          "name": "complete_run",
          "next": "completed",
          "processors": [
            {
              "config": {
                "attachEntity": false,
                "calculationNodesTags": "cyoda_application"
              },
              "executionMode": "ASYNC_NEW_TX",
              "name": "RunCompletionLocker"
            }
          ]
        }
      ]
    },
    "completed": {
      "transitions": []
    },
    "planned": {
      "transitions": [
        {
          "allowedRoles": [
            "Admin",
            "Tester"
          ],
          "description": "Start the test run and set started_at",
          "manual": true,
          "name": "start_run",
          "next": "active",
          "processors": [
            {
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "cyoda_application"
              },
              "executionMode": "SYNC",
              "name": "SetStartedAt"
            }
          ]
        }
      ]
    }
  }
}