{"name":"OrderMatching","version":1,"initialState":"start","states":[{"name":"start","on_enter":{"action":{"type":"log","message":"Received new order"}}}],"triggers":[{"type":"api","endpoint":"/orders","method":"POST","description":"Receive new orders"}],"steps":[{"id":"validate","action":{"type":"validate","description":"Validate order fields, user KYC status and balance"},"on_error":{"action":{"type":"reject","message":"Invalid order"},"next":"end"}},{"id":"insert_book","action":{"type":"persist","resource":"order_book","description":"Insert order into order book storage"},"on_error":{"action":{"type":"retry","retries":2,"next":"alert"}},{"id":"match","action":{"type":"invoke","service":"matching_engine","description":"Attempt to match against opposite side"},"on_error":{"action":{"type":"log","level":"error","message":"Matching error"}},{"id":"emit_events","action":{"type":"emit_event","events":["order_accepted","trade_executed"],"description":"Emit order and trade events"},{"id":"persist_audit","action":{"type":"persist","resource":"audit_log","description":"Persist matching audit trail"}]}],"error_handling":{"alerts":"trading_ops"}